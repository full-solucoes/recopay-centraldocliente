# URL base da API RecoPay (sem barra final).
# Em desenvolvimento as chamadas sao proxyadas pelo Vite (ver vite.config.js).
VITE_API_URL=http://localhost:8080

# Base publico do build (path). Use '/' para https://clientes.recopay.com.br.
VITE_APP_BASE_URL=/

# Identificador publico (checkoutPublicoId) da empresa padrao do portal.
# Usado como fallback caso nao seja possivel derivar da URL (subdominio/query).
# Exemplo para clientes.recopay.com.br de uma empresa especifica:
# VITE_CHECKOUT_PUBLICO_ID=empresa-publica
VITE_CHECKOUT_PUBLICO_ID=
